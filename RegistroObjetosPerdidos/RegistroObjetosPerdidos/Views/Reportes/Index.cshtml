@model IEnumerable<RegistroObjetosPerdidos.Models.Reporte>

@{
    ViewData["Title"] = "Reportes";
}

<h1>Objetos perdidos y encontrados</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Registrar objeto</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Objeto</th>
            <th>Descripción</th>
            <th>Tipo</th>
            <th>Ubicación</th>
            <th>Fecha</th>
            <th>Estado</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            @foreach (var reporte in Model)
            {
                <tr>
                    <td>@reporte.NombreObjeto</td>
                    <td>@reporte.Descripcion</td>
                    <td>@reporte.Tipo</td>
                    <td>@reporte.Ubicacion</td>
                    <td>@reporte.FechaReporte.ToShortDateString()</td>
                    <td>@reporte.Estado</td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@reporte.Id" class="btn btn-warning btn-sm">Editar</a>
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="7" class="text-center">No hay reportes registrados.</td>
            </tr>
        }
    </tbody>
</table>