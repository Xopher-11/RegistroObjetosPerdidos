@model RegistroObjetosPerdidos.Models.Reporte

@{
    ViewData["Title"] = "Eliminar reporte";
}

<h1>Eliminar reporte</h1>

<h4>¿Estás seguro de que deseas eliminar este reporte?</h4>

<div class="mb-3">
    <p><strong>Objeto:</strong> @Model.NombreObjeto</p>
    <p><strong>Descripción:</strong> @Model.Descripcion</p>
    <p><strong>Tipo:</strong> @Model.Tipo</p>
    <p><strong>Ubicación:</strong> @Model.Ubicacion</p>
</div>

<form asp-action="Delete" method="post">
    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">Eliminar</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>