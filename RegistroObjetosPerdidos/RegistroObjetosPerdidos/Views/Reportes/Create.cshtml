@model RegistroObjetosPerdidos.Models.Reporte

@{
    ViewData["Title"] = "Registrar objeto";
}

<h1>Registrar objeto</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="NombreObjeto" class="form-label">Nombre del objeto</label>
        <input asp-for="NombreObjeto" class="form-control" />
        <span asp-validation-for="NombreObjeto" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label">Descripción</label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
        <span asp-validation-for="Descripcion" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Tipo" class="form-label">Tipo de reporte</label>
        <select asp-for="Tipo" class="form-select">
            <option value="">Seleccione una opción</option>
            <option value="Perdido">Objeto perdido</option>
            <option value="Encontrado">Objeto encontrado</option>
        </select>
        <span asp-validation-for="Tipo" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Ubicacion" class="form-label">Ubicación</label>
        <input asp-for="Ubicacion" class="form-control" />
        <span asp-validation-for="Ubicacion" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Guardar reporte</button>

    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>

</form>
